# GCP Vertex AI configuration for sandbox inference.
# Placeholders are expanded by the harness (expand: true) from runner
# environment variables set by the setup-gcp action in reusable-dispatch.yml.
export CLOUD_ML_PROJECT_ID=${FULLSEND_GCP_PROJECT_ID}
export CLOUD_ML_REGION=${FULLSEND_GCP_REGION}
# Point the GCP SDK at the credential file mapped by host_files.
export GOOGLE_APPLICATION_CREDENTIALS=/tmp/.gcp-credentials.json
