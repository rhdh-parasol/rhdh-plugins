{
  "name": "@red-hat-developer-hub/backstage-plugin-lifecycle",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Catalog lifecycle and provenance view for RHDH plugins",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./legacy": "./src/legacy.ts",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "legacy": [
        "src/legacy.ts"
      ],
      "package.json": [
        "package.json"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "backstage": {
    "role": "frontend-plugin",
    "pluginId": "plugin-lifecycle",
    "pluginPackages": [
      "@red-hat-developer-hub/backstage-plugin-lifecycle",
      "@red-hat-developer-hub/backstage-plugin-lifecycle-backend",
      "@red-hat-developer-hub/backstage-plugin-lifecycle-common"
    ]
  },
  "scalprum": {
    "name": "rhdh-parasol.backstage-plugin-lifecycle",
    "exposedModules": {
      "PluginRoot": "./src/index.ts",
      "Legacy": "./src/legacy.ts"
    }
  },
  "sideEffects": false,
  "scripts": {
    "start": "backstage-cli package start",
    "build": "backstage-cli package build",
    "clean": "backstage-cli package clean",
    "export-dynamic": "rhdh-cli plugin export --clean",
    "package-dynamic": "rhdh-cli plugin package --export-to ../../dist-dynamic-packages/frontend",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "dependencies": {
    "@backstage/catalog-model": "^1.10.0",
    "@backstage/core-plugin-api": "^1.12.9",
    "@backstage/errors": "^1.3.1",
    "@backstage/frontend-plugin-api": "^0.18.0",
    "@backstage/plugin-catalog-react": "^3.2.2",
    "@backstage/ui": "^0.17.1",
    "@red-hat-developer-hub/backstage-plugin-lifecycle-common": "workspace:^",
    "@remixicon/react": "^4.8.0"
  },
  "peerDependencies": {
    "react": "^16.13.1 || ^17.0.0 || ^18.0.0"
  },
  "devDependencies": {
    "@backstage/cli": "^0.36.5",
    "@backstage/frontend-defaults": "^0.5.5",
    "@backstage/frontend-dev-utils": "^0.1.5",
    "@backstage/frontend-test-utils": "^0.6.3",
    "@red-hat-developer-hub/cli": "2.0.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.0.0",
    "ts-morph": "28.0.0"
  },
  "files": [
    "app-config.dynamic.yaml",
    "dist",
    "dist-scalprum",
    "dist-dynamic/*.*",
    "dist-dynamic/dist/**"
  ]
}
