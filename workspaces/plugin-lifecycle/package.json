{
  "name": "@internal/plugin-lifecycle",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22 || 24"
  },
  "scripts": {
    "start": "backstage-cli repo start --config ../../app-config.yaml --config ../../app-config.live.yaml packages/app packages/backend",
    "start:plugins": "backstage-cli repo start plugins/plugin-lifecycle plugins/plugin-lifecycle-backend",
    "tsc": "tsc",
    "tsc:full": "tsc --skipLibCheck true --incremental false",
    "build:all": "backstage-cli repo build --all",
    "export-dynamic": "yarn workspaces foreach --all --topological-dev --include '@red-hat-developer-hub/backstage-plugin-lifecycle' --include '@red-hat-developer-hub/backstage-plugin-lifecycle-backend' run export-dynamic",
    "package-dynamic": "yarn workspaces foreach --all --topological-dev --include '@red-hat-developer-hub/backstage-plugin-lifecycle' --include '@red-hat-developer-hub/backstage-plugin-lifecycle-backend' run package-dynamic",
    "build:api-reports": "yarn build:api-reports:only --tsc",
    "build:api-reports:only": "backstage-repo-tools api-reports -o ae-wrong-input-file-type,ae-undocumented --validate-release-tags",
    "build:knip-reports": "backstage-repo-tools knip-reports",
    "clean": "backstage-cli repo clean",
    "test": "backstage-cli repo test",
    "test:all": "backstage-cli repo test --coverage",
    "fix": "backstage-cli repo fix",
    "lint": "backstage-cli repo lint --since origin/main",
    "lint:all": "backstage-cli repo lint",
    "prettier:check": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "new": "backstage-cli new --scope @red-hat-developer-hub",
    "postinstall": "cd ../../ && yarn install"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "plugins/*"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rhdh-parasol/rhdh-plugins",
    "directory": "workspaces/plugin-lifecycle"
  },
  "packageManager": "yarn@4.17.1",
  "devDependencies": {
    "@backstage/cli": "^0.36.5",
    "@backstage/cli-defaults": "^0.1.5",
    "@backstage/e2e-test-utils": "^0.1.2",
    "@backstage/repo-tools": "^0.19.0",
    "@changesets/cli": "^2.27.1",
    "@jest/environment-jsdom-abstract": "~30.2.0",
    "@microsoft/api-extractor-model": "^7.30.0",
    "@microsoft/tsdoc": "^0.15.1",
    "@microsoft/tsdoc-config": "^0.17.0",
    "@types/jest": "^30.0.0",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^22.0.0",
    "jest": "~30.2.0",
    "jsdom": "^27.1.0",
    "knip": "^5.27.4",
    "node-gyp": "^10.0.0",
    "prettier": "^2.3.2",
    "typescript": "~5.8.0"
  },
  "resolutions": {
    "@types/react": "^18",
    "@types/react-dom": "^18"
  },
  "prettier": "@backstage/cli/config/prettier",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
